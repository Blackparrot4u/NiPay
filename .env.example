# Placeholders only. Copy to .env if you want to override defaults; never commit the real file.
# Everything is optional: with no .env the server generates its own keys on first run into backend/data/ (gitignored).

# Database. Default is SQLite in backend/data/. A Postgres URL works the same way:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/nipay
DATABASE_URL=

# Where secrets.json (bank signing key, monthly seed, admin passwords) and nipay.db live.
NIPAY_DATA_DIR=

# Override the generated secrets (base64 of 32 random bytes each). Leave empty to auto-generate.
NIPAY_SIGNING_KEY=
NIPAY_SEED=
NIPAY_ADMIN_PASSWORD_ADMIN=
NIPAY_ADMIN_PASSWORD_RISK=
NIPAY_ADMIN_PASSWORD_AUDITOR=

# Mock sign-up OTP (no SMS is ever sent) and request limits.
NIPAY_DEMO_OTP=123456
NIPAY_RATE_LIMIT=600
NIPAY_LOGIN_RATE=20

HOST=0.0.0.0
USER_PORT=8000
ADMIN_PORT=8001
