{
  "name": "nipay",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite -c vite.user.config.ts",
    "build": "tsc --noEmit && vite build -c vite.user.config.ts && vite build -c vite.admin.config.ts",
    "preview": "vite preview -c vite.user.config.ts",
    "lint": "tsc --noEmit",
    "test:vectors": "tsx scripts/vectors.test.ts",
    "clean": "rm -rf dist",
    "dev:admin": "vite -c vite.admin.config.ts",
    "test": "npm run test:vectors && tsx scripts/devchecks.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsqr": "^1.4.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
